# Copie este arquivo para .env. Sem .env o sistema assume PRODUÇÃO: DEBUG desligado,
# só localhost, e não sobe sem SECRET_KEY.
#
# Por padrão o banco é SQLite (não precisa configurar nada).
# Para usar PostgreSQL, descomente a linha abaixo e ajuste os dados:
# DATABASE_URL=postgres://maryhouse:senha@localhost:5432/maryhouse

# DEBUG=True só em desenvolvimento. Com ele ligado e SECRET_KEY vazia, vale uma chave
# de desenvolvimento embutida no settings.py.
DEBUG=True

# Obrigatória em produção. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Hosts permitidos (separados por vírgula). Em produção, o domínio do sistema.
ALLOWED_HOSTS=localhost,127.0.0.1

# Em produção com HTTPS: https://<domínio>, senão todo POST é recusado.
CSRF_TRUSTED_ORIGINS=
