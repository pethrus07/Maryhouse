# Copie este arquivo para .env e ajuste se necessário.
#
# Por padrão o sistema usa SQLite (não precisa configurar nada).
# Para usar PostgreSQL, descomente a linha abaixo e ajuste os dados:
# DATABASE_URL=postgres://maryhouse:senha@localhost:5432/maryhouse

# Chave secreta — gere uma nova para produção.
SECRET_KEY=troque-esta-chave-em-producao

# DEBUG=True em desenvolvimento, False em produção.
DEBUG=True

# Hosts permitidos (separados por vírgula) e origens CSRF confiáveis.
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
